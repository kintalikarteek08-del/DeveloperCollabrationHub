# Server Production Environment Variables
# Set these in your Render / Railway / Cloud dashboard

# Server port assigned by hosting provider (defaults to 5000 if omitted)
PORT=5000

# Environment mode ('production' in production, 'development' locally)
NODE_ENV=production

# Frontend Origin(s) allowed by CORS
# Comma-separated if multiple (e.g. production domain + staging preview)
CLIENT_URL=https://developer-collaboration-hub.vercel.app

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devcollab?retryWrites=true&w=majority

# JWT Security
# Generate a strong 64-character random string (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_production_random_secret_key_here
JWT_EXPIRES_IN=7d
