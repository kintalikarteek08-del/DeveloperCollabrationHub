# Frontend Production Environment Variables
# Set these in your hosting provider's dashboard (e.g. Vercel / Netlify / Render)

# Base URL of the deployed backend API (must include /api prefix)
VITE_API_URL=https://your-backend-api.onrender.com/api

# Base URL for Socket.IO connection (optional; if omitted, derived from VITE_API_URL)
VITE_SOCKET_URL=https://your-backend-api.onrender.com
